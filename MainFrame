package cafe;

import java.awt.*;
import java.net.URL;
import javax.swing.*;
import javax.swing.border.EmptyBorder;

public class MainFrame extends JFrame {

    private Order currentOrder;

    // Drink UI Components
    private JComboBox<String> cmbCategory;
    private JComboBox<String> cmbDrinkName;
    private JComboBox<String> cmbSize;
    private JComboBox<String> cmbTemp;
    private JComboBox<String> cmbMilk;
    private JSpinner spnExtraShots;
    private JComboBox<String> cmbSyrup;
    private JComboBox<String> cmbColdFoam;
    private JCheckBox chkWhippedCream;
    private JCheckBox chkSprinkles;
    private JSpinner spnDrinkQty;
    private JLabel lblLiveDrinkPrice;
    private JLabel lblDrinkImage;

    // Pastry UI Components
    private JComboBox<String> cmbPastry;
    private JSpinner spnPastryQty;
    private JLabel lblPastryImage;

    // Order & Receipt UI Components
    private JComboBox<String> cmbTip;
    private JTextArea txtReceipt;

    public static void main(String[] args) {
        EventQueue.invokeLater(() -> {
            try {
                MainFrame frame = new MainFrame();
                frame.setVisible(true);
            } catch (Exception e) {
                e.printStackTrace();
            }
        });
    }

    public MainFrame() {
        currentOrder = new Order();

        setTitle("Bean There Cafe");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setBounds(100, 100, 980, 640);

        JPanel contentPane = new JPanel(new BorderLayout(10, 10));
        contentPane.setBorder(new EmptyBorder(10, 10, 10, 10));
        setContentPane(contentPane);

        // --- LEFT PANEL: DRINK BUILDER ---
        JPanel pnlDrink = new JPanel(new GridLayout(11, 2, 5, 5));
        pnlDrink.setBorder(BorderFactory.createTitledBorder("1. Customize Drink"));

        cmbCategory = new JComboBox<>(new String[]{"Coffee", "Matcha", "Tea"});
        cmbDrinkName = new JComboBox<>();
        cmbSize = new JComboBox<>(new String[]{"Small", "Medium", "Large"});
        cmbTemp = new JComboBox<>(new String[]{"Hot", "Iced"});
        cmbMilk = new JComboBox<>(new String[]{"Whole", "Oat", "Almond", "Soy", "None"});
        spnExtraShots = new JSpinner(new SpinnerNumberModel(0, 0, 5, 1));
        cmbSyrup = new JComboBox<>(new String[]{
            "None", "Vanilla", "Caramel", "Mocha", "Brown Sugar", "Blueberry", "Strawberry", "Pistachio"
        });
        cmbColdFoam = new JComboBox<>(new String[]{
            "None", "Cookie Butter", "Vanilla", "Marshmallow", "Caramel", "Brown Sugar", "Pumpkin"
        });
        chkWhippedCream = new JCheckBox("Whipped Cream (+$0.50)");
        chkSprinkles = new JCheckBox("Sprinkles (Free w/ Coffee/Matcha)");
        spnDrinkQty = new JSpinner(new SpinnerNumberModel(1, 1, 20, 1));
        lblLiveDrinkPrice = new JLabel("Drink Total: $3.00");
        lblLiveDrinkPrice.setFont(new Font("SansSerif", Font.BOLD, 13));

        JButton btnAddDrink = new JButton("Add Drink to Order");

        pnlDrink.add(new JLabel("Category:"));           pnlDrink.add(cmbCategory);
        pnlDrink.add(new JLabel("Drink:"));              pnlDrink.add(cmbDrinkName);
        pnlDrink.add(new JLabel("Size:"));               pnlDrink.add(cmbSize);
        pnlDrink.add(new JLabel("Temperature:"));        pnlDrink.add(cmbTemp);
        pnlDrink.add(new JLabel("Milk:"));               pnlDrink.add(cmbMilk);
        pnlDrink.add(new JLabel("Extra Shots (+$1):"));  pnlDrink.add(spnExtraShots);
        pnlDrink.add(new JLabel("Syrup (+$0.70):"));     pnlDrink.add(cmbSyrup);
        pnlDrink.add(new JLabel("Cold Foam (+$1.00):")); pnlDrink.add(cmbColdFoam);
        pnlDrink.add(chkWhippedCream);                   pnlDrink.add(chkSprinkles);
        pnlDrink.add(new JLabel("Quantity:"));           pnlDrink.add(spnDrinkQty);
        pnlDrink.add(lblLiveDrinkPrice);                 pnlDrink.add(btnAddDrink);

        // --- CENTER PANEL: PASTRIES & PREVIEW IMAGES ---
        JPanel pnlCenter = new JPanel(new BorderLayout(10, 10));

        JPanel pnlPastry = new JPanel(new GridLayout(3, 2, 5, 5));
        pnlPastry.setBorder(BorderFactory.createTitledBorder("2. Add Pastry"));

        cmbPastry = new JComboBox<>(new String[]{
            "Croissant ($2.50)",
            "Chocolate Chip Cookie ($1.00)",
            "Cinnamon Roll ($2.50)",
            "Bagel ($1.00)"
        });
        spnPastryQty = new JSpinner(new SpinnerNumberModel(1, 1, 20, 1));
        JButton btnAddPastry = new JButton("Add Pastry to Order");

        pnlPastry.add(new JLabel("Select Pastry:")); pnlPastry.add(cmbPastry);
        pnlPastry.add(new JLabel("Quantity:"));      pnlPastry.add(spnPastryQty);
        pnlPastry.add(new JLabel(""));               pnlPastry.add(btnAddPastry);

        JPanel pnlImages = new JPanel(new GridLayout(2, 1, 5, 5));
        pnlImages.setBorder(BorderFactory.createTitledBorder("Item Preview"));

        lblDrinkImage = new JLabel("Drink Preview", SwingConstants.CENTER);
        lblDrinkImage.setPreferredSize(new Dimension(180, 160));
        lblPastryImage = new JLabel("Pastry Preview", SwingConstants.CENTER);
        lblPastryImage.setPreferredSize(new Dimension(180, 160));

        pnlImages.add(lblDrinkImage);
        pnlImages.add(lblPastryImage);

        pnlCenter.add(pnlPastry, BorderLayout.NORTH);
        pnlCenter.add(pnlImages, BorderLayout.CENTER);

        // --- RIGHT PANEL: RECEIPT & CHECKOUT ---
        JPanel pnlRight = new JPanel(new BorderLayout(5, 5));
        pnlRight.setBorder(BorderFactory.createTitledBorder("3. Current Order"));

        txtReceipt = new JTextArea(20, 28);
        txtReceipt.setEditable(false);
        txtReceipt.setFont(new Font("Monospaced", Font.PLAIN, 12));

        JPanel pnlActions = new JPanel(new GridLayout(2, 2, 5, 5));
        cmbTip = new JComboBox<>(new String[]{"0%", "10%", "15%", "18%", "20%"});
        JButton btnCheckout = new JButton("Checkout");
        JButton btnClear = new JButton("Clear Order");

        pnlActions.add(new JLabel("Tip Percentage:")); pnlActions.add(cmbTip);
        pnlActions.add(btnCheckout);                   pnlActions.add(btnClear);

        pnlRight.add(new JScrollPane(txtReceipt), BorderLayout.CENTER);
        pnlRight.add(pnlActions, BorderLayout.SOUTH);

        contentPane.add(pnlDrink, BorderLayout.WEST);
        contentPane.add(pnlCenter, BorderLayout.CENTER);
        contentPane.add(pnlRight, BorderLayout.EAST);

        // --- EVENT LISTENERS ---
        cmbCategory.addActionListener(e -> updateDrinksForCategory());

        cmbDrinkName.addActionListener(e -> {
            if (cmbDrinkName.getSelectedItem() != null) {
                updateSprinkleAvailability();
                calculateDrinkPrice();
                updateImages();
            }
        });
        cmbTemp.addActionListener(e -> { calculateDrinkPrice(); updateImages(); });
        cmbColdFoam.addActionListener(e -> { calculateDrinkPrice(); updateImages(); });
        cmbSize.addActionListener(e -> calculateDrinkPrice());
        cmbMilk.addActionListener(e -> calculateDrinkPrice());
        spnExtraShots.addChangeListener(e -> calculateDrinkPrice());
        cmbSyrup.addActionListener(e -> calculateDrinkPrice());
        chkWhippedCream.addActionListener(e -> calculateDrinkPrice());
        chkSprinkles.addActionListener(e -> calculateDrinkPrice());
        spnDrinkQty.addChangeListener(e -> calculateDrinkPrice());

        cmbPastry.addActionListener(e -> updateImages());
        cmbTip.addActionListener(e -> refreshReceiptPreview());

        btnAddDrink.addActionListener(e -> addDrinkToOrder());
        btnAddPastry.addActionListener(e -> addPastryToOrder());
        btnCheckout.addActionListener(e -> checkout());
        btnClear.addActionListener(e -> clearOrder());

        // Populate initial drink choices and preview
        updateDrinksForCategory();
    }

    private void updateDrinksForCategory() {
        String category = (String) cmbCategory.getSelectedItem();
        cmbDrinkName.removeAllItems();

        if ("Coffee".equalsIgnoreCase(category)) {
            cmbDrinkName.addItem("Espresso");
            cmbDrinkName.addItem("Doppio");
            cmbDrinkName.addItem("Ristretto");
            cmbDrinkName.addItem("Lungo");
        } else if ("Matcha".equalsIgnoreCase(category)) {
            cmbDrinkName.addItem("Matcha");
        } else if ("Tea".equalsIgnoreCase(category)) {
            cmbDrinkName.addItem("Black Tea");
            cmbDrinkName.addItem("Green Tea");
        }

        updateSprinkleAvailability();
        calculateDrinkPrice();
        updateImages();
    }

    private void updateSprinkleAvailability() {
        String category = (String) cmbCategory.getSelectedItem();
        boolean eligible = "Coffee".equalsIgnoreCase(category) || "Matcha".equalsIgnoreCase(category);
        chkSprinkles.setEnabled(eligible);
        if (!eligible) {
            chkSprinkles.setSelected(false);
        }
    }

    private Drink buildCurrentDrinkFromUI() {
        String drinkName = cmbDrinkName.getSelectedItem() != null
                ? (String) cmbDrinkName.getSelectedItem()
                : "Espresso";
        return new Drink(
            (String) cmbCategory.getSelectedItem(),
            drinkName,
            (String) cmbSize.getSelectedItem(),
            (String) cmbTemp.getSelectedItem(),
            (String) cmbMilk.getSelectedItem(),
            (Integer) spnExtraShots.getValue(),
            (String) cmbSyrup.getSelectedItem(),
            (String) cmbColdFoam.getSelectedItem(),
            chkWhippedCream.isSelected(),
            chkSprinkles.isSelected(),
            (Integer) spnDrinkQty.getValue()
        );
    }

    public void calculateDrinkPrice() {
        Drink preview = buildCurrentDrinkFromUI();
        lblLiveDrinkPrice.setText(String.format("Drink Total: $%.2f", preview.getItemTotal()));
    }

    public void addDrinkToOrder() {
    	Drink drink = buildCurrentDrinkFromUI();
        currentOrder.addDrink(drink);
        refreshReceiptPreview();
    }

    public void addPastryToOrder() {
        String selected = (String) cmbPastry.getSelectedItem();
        int qty = (Integer) spnPastryQty.getValue();
        double price = 2.50;
        String cleanName = "Croissant";

        if (selected.startsWith("Chocolate Chip Cookie")) {
            cleanName = "Chocolate Chip Cookie";
            price = 1.00;
        } else if (selected.startsWith("Cinnamon Roll")) {
            cleanName = "Cinnamon Roll";
            price = 2.50;
        } else if (selected.startsWith("Bagel")) {
            cleanName = "Bagel";
            price = 1.00;
        }

        Pastry pastry = new Pastry(cleanName, qty, price);
        currentOrder.addPastry(pastry);
        refreshReceiptPreview();
    }

    public void checkout() {
        applySelectedTip();
        txtReceipt.setText(currentOrder.generateReceipt());
        JOptionPane.showMessageDialog(this,
                String.format("Order Complete!\nSubtotal: $%.2f\nTip: $%.2f\nFinal Total: $%.2f",
                        currentOrder.calculateSubtotal(),
                        currentOrder.calculateTip(),
                        currentOrder.calculateTotal()),
                "Checkout", JOptionPane.INFORMATION_MESSAGE);
    }

    public void clearOrder() {
        currentOrder = new Order();
        cmbCategory.setSelectedIndex(0);
        updateDrinksForCategory();
        cmbSize.setSelectedIndex(0);
        cmbTemp.setSelectedIndex(0);
        cmbMilk.setSelectedIndex(0);
        spnExtraShots.setValue(0);
        cmbSyrup.setSelectedIndex(0);
        cmbColdFoam.setSelectedIndex(0);
        chkWhippedCream.setSelected(false);
        chkSprinkles.setSelected(false);
        spnDrinkQty.setValue(1);
        spnPastryQty.setValue(1);
        cmbTip.setSelectedIndex(0);
        txtReceipt.setText("");
        calculateDrinkPrice();
        updateImages();
    }

    private void applySelectedTip() {
        String tipStr = ((String) cmbTip.getSelectedItem()).replace("%", "");
        double tipPct = Double.parseDouble(tipStr) / 100.0;
        currentOrder.setTipPercentage(tipPct);
    }

    private void refreshReceiptPreview() {
        applySelectedTip();
        txtReceipt.setText(currentOrder.generateReceipt());
    }

    private void updateImages() {
        String category = (String) cmbCategory.getSelectedItem();
        String drink = (String) cmbDrinkName.getSelectedItem();
        if (drink == null) drink = "Espresso";
        String temp = (String) cmbTemp.getSelectedItem();
        String coldFoam = (String) cmbColdFoam.getSelectedItem();

        String drinkFile = "hot_coffee.jpg";

        if (!"None".equalsIgnoreCase(coldFoam)) {
            drinkFile = "cold_foam.jpg";
        } else if ("Matcha".equalsIgnoreCase(category)) {
            drinkFile = "Hot".equalsIgnoreCase(temp) ? "hot_matcha.jpg" : "matcha.jpg";
        } else if ("Green Tea".equalsIgnoreCase(drink)) {
            drinkFile = "green_tea.jpg";
        } else if ("Black Tea".equalsIgnoreCase(drink)) {
            drinkFile = "black_tea.jpg";
        } else {
            drinkFile = "Iced".equalsIgnoreCase(temp) ? "cold_coffee.jpg" : "hot_coffee.jpg";
        }

        setScaledIcon(lblDrinkImage, "/images/" + drinkFile, drink);

        String pastrySelected = (String) cmbPastry.getSelectedItem();
        String pastryFile = "croissamt.jpg";

        if (pastrySelected.startsWith("Chocolate Chip Cookie")) {
            pastryFile = "choco_cookie.jpg";
        } else if (pastrySelected.startsWith("Cinnamon Roll")) {
            pastryFile = "cinnamon_rolls.jpg";
        } else if (pastrySelected.startsWith("Bagel")) {
            pastryFile = "bagel.jpg";
        }

        setScaledIcon(lblPastryImage, "/images/" + pastryFile, pastrySelected);
    }

    private void setScaledIcon(JLabel label, String resourcePath, String fallbackText) {
        URL imgUrl = getClass().getResource(resourcePath);
        if (imgUrl != null) {
            ImageIcon icon = new ImageIcon(imgUrl);
            int w = label.getWidth() > 0 ? label.getWidth() : 160;
            int h = label.getHeight() > 0 ? label.getHeight() : 140;
            Image scaled = icon.getImage().getScaledInstance(w, h, Image.SCALE_SMOOTH);
            label.setIcon(new ImageIcon(scaled));
            label.setText("");
        } else {
            label.setIcon(null);
            label.setText(fallbackText);
        }
    }
}
